# ==============================================================================
# NexusCRM - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and populate the variables with your Supabase credentials.
# Note: Do NOT commit '.env' to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Core Integration
# ------------------------------------------------------------------------------

# The API URL endpoint of your Supabase project.
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Can be retrieved under Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The anonymous API public key.
# Used for browser-side requests and subject to Row Level Security policies.
# Can be retrieved under Project Settings > API > Project API Keys (anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# Database Webhooks Security
# ------------------------------------------------------------------------------

# HMAC-SHA256 secret key for database webhook payload verification.
# Configured under Database > Webhooks in Supabase Dashboard.
WEBHOOK_SECRET=your-hmac-secret-here

# ------------------------------------------------------------------------------
# Email Integration & Resend API
# ------------------------------------------------------------------------------

# Resend API Key for transactional email delivery.
# Retrieve from https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=noreply@yournexuscrm.app
RESEND_FROM_NAME=NexusCRM

# ------------------------------------------------------------------------------
# Developer REST API & Edge Security
# ------------------------------------------------------------------------------

# Bcrypt salt rounds for hashing secret API keys.
API_KEY_BCRYPT_ROUNDS=12

# Supabase Service Role Key for background cron functions and Edge Workers.
# Retrieve under Project Settings > API > service_role in Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
